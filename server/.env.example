# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# Secret used to sign JWTs. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin allowed by CORS (the Vite dev server by default). Verification-email links also point here.
CLIENT_URL=http://localhost:5173

# Comma-separated email domains allowed to register (only students with one of these can create an
# account). Defaults to the University of Hyderabad's current and legacy domains if unset. Set to
# an empty string to allow any domain, e.g. for local development.
# ALLOWED_EMAIL_DOMAINS=uohyd.ac.in,uohyd.ernet.in

# Outgoing email (optional). New accounts must verify their email before they can log in again.
# Without these, the verification link is just printed to this server's console instead of
# emailed — fine for local development/demos. For a real deploy, fill in an SMTP provider, e.g.
# Gmail (an App Password, not your normal password), SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Video classes (optional). The app works without these, but joining a video room will show
# "video is not set up". Create a free app at https://jaas.8x8.vc, add an API key, then paste:
#   JAAS_APP_ID      the AppID, e.g. vpaas-magic-cookie-1fc542a3e4414a44b2611668195e2bfe
#   JAAS_KEY_ID      the API key ID (the "kid" suffix, e.g. 4f4910)
#   JAAS_PRIVATE_KEY the private key PEM, on ONE line with literal \n between lines
JAAS_APP_ID=
JAAS_KEY_ID=
JAAS_PRIVATE_KEY=
